root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json,cff}]
indent_size = 2

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.py]
indent_size = 4
max_line_length = 100

[*.{yar,yara}]
indent_size = 2
trim_trailing_whitespace = false
